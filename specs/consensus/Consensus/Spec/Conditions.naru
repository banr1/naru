// verified-consensus の移植: DecoupledConsensusStatements/Generic/Conditions.lean(execution conditions、synchrony と
// participation の述語、committee の条件、proposer recurrence の条件)。
//
// - `E : Env V`(Δ / t_GST / electorate / awake)→ `s.e`(ProtocolEnv)と `envAwake(s, v, t)`(Interface.naru)。
//   `I : Interface P` の欄 → Interface.naru の宣言、`C : Constants` の欄 → Constants.naru の fn。
// - `structure … : Prop where`(欄が複数)→ `&&` で束ねた condition。`extends` → 親の condition を `&&` に含める。
//   `ScheduleWellFormed` / `UnforgeableRun` / `RunWellFormed` が共有する欄(`sorted` / `nodup` / `honest_only`)は
//   `EventsSorted` / `EventsNodup` / `HonestOnly` に切り出す。
// - `rho.events.Pairwise (fun e f => e.key ≤ f.key)` / `rho.events.Nodup` → 添字 `i < j` の 2 要素の量化(`get?`)。
// - `awakeIn E H a b`(`∃ u, …` で filter する noncomputable な集合)は naru の `filter`(Bool)では書けないので、
//   集合を特徴付ける `AwakeInExactly(s, h, a, b, w)`(`w` の要素 ⟺ `[a, b)` のどこかで awake)を書き、`WindowMajority` /
//   `FreshMajority` はその集合 `w` を `exists members: List + toSet()` で量化して重みを取る(有限集合なので存在し、
//   正規形は一意。Accountability.naru と同じ書き方)。
// - `Finset.univ \ H` → `validators(s.e.electorate).diff(h)`(electorate の外の重みは 0。Weights.naru の冒頭)。
// - `(I.committee s).card` → `committee(k).size()`、`∩` → `inter`。
// - 手書きの型が暗黙に保証する前提は、naru では condition として claim の premise に書く(`SetupWellFormed` / `RunDomain`):
//   `Setup` / `Env` / `HealConfig` / `HeightConfig` / `Electorate` の証明の欄(Δ_pos / t_GST_nonneg / R_ge_three / η_SG_ge_one /
//   K_ge_four / D_ge_two / timeout_rounds / committee_nonempty / outage_window / weight_pos。Model の各ファイルの冒頭が
//   「Statements の premise にする」とした欄)、`Finset` が型で保証する正規形(naru の `Set` / `Table` は昇順・重複なしの不変条件を
//   型に持たないので、量化される `rho.honest` / `committee(k)` / electorate の鍵は `xs == sort(xs, by = …).toSet()` で正規形を
//   要求する。`docs/architecture.md`「Statements backend」の既知の制限)、validator の型 `V` が electorate そのものであること(naru の
//   `ValidatorId` は Nat 全体なので、proposer / committee / honest が electorate に含まれることを要求する)。
module Consensus.Spec.Conditions

import Consensus.Objects.Identifiers
import Consensus.Objects.Time
import Consensus.Objects.Weights
import Consensus.Objects.Parameters
import Consensus.Protocol.Schedule
import Consensus.Execution.Objects
import Consensus.Execution.Setup
import Consensus.Execution.Node
import Consensus.Execution.Run
import Consensus.Spec.Execution
import Consensus.Spec.Interface
import Consensus.Spec.Constants

// ── The domain the handwritten types guarantee: well-formed setup and run ──

// validator 集合が naru の正規形(昇順・重複なし)であるかを判定する。
// 手書きでは有限集合の型が正規形を保証するので、手書きに直接の対応物は無い(naru の `Set` は不変条件を型に持たない)。
// `sort` は重複を残し `toSet()` が正規化するので、集合が自分の正規化と等しいことが正規形であることの条件になる。
// SetupWellFormed が electorate の鍵と committee に、RunDomain が honest 集合に使う。
fn normalizedValidators(xs: Set<ValidatorId>) -> Bool { xs == sort(xs, by = |v| v).toSet() }

// 設定 Setup が、手書きモデルでは型と証明の欄が保証していた前提をすべて満たすことを表す。
// 手書き `Env` の Δ_pos / t_GST_nonneg(0 < delta、0 <= tGST)、手書き `HealConfig` の R_ge_three / η_SG_ge_one、
// 手書き `HeightConfig` の K_ge_four / D_ge_two(k >= 4、d >= 2)を、それぞれ数値の不等式として書く。
// 手書き `Setup` の timeout_rounds(timeoutDelay が r の倍数かつ 2r 以上)、outage_window(4 <= r * etaSG)も同じ。
// 手書き `Electorate` の weight_pos は electorate の各 validator の重みが正であること、committee_nonempty は全 slot の
// committee が空でないことで、さらに型が保証していた正規形と「committee の成員と proposer は electorate の成員」を足す。
// 手書きの型は validator の型 V が electorate そのものだが、naru の ValidatorId は Nat 全体なので、この条件で補う。
// claim の premise に置く前提であり、結論側には現れない。
condition SetupWellFormed(s: Setup) {
  0 < s.e.delta
    && 0 <= s.e.tGST
    && 3 <= s.hc.r
    && 1 <= s.hc.etaSG
    && 4 <= s.cfg.k
    && 2 <= s.cfg.d
    && s.cfg.timeoutDelay % s.hc.r == 0
    && 2 * s.hc.r <= s.cfg.timeoutDelay
    && 4 <= s.hc.r * s.hc.etaSG
    && normalizedValidators(validators(s.e.electorate))
    && (forall v: ValidatorId {
         validators(s.e.electorate).contains(v) implies 0 < weightOfValidator(s.e.electorate, v)
       })
    && (forall k: Slot {
         !committee(k).isEmpty()
           && normalizedValidators(committee(k))
           && committee(k).subset(validators(s.e.electorate))
           && validators(s.e.electorate).contains(proposer(k))
       })
}

// 実行 rho の honest 集合が、手書きの型が保証する形(electorate の成員からなる正規集合)であることを表す。
// 条件は 2 つで、`normalizedValidators(rho.honest)` と、honest 集合が electorate の validators の部分集合であること。
// 手書き `Run.honest` は有限集合の型なので重複せず、かつ validator の型が electorate なので成員は必ず electorate に入る。
// naru の `ValidatorId` は Nat 全体で `Set` も不変条件を持たないため、正規形と部分集合関係を条件として明示する。
// SetupWellFormed が設定側の同種の前提を担い、この条件は実行側を担う。手書きに直接の対応物は無い。
// 両者は claim の premise として並べられ、定理の仮定の一部になる。
condition RunDomain(s: Setup, rho: NamedRun) {
  normalizedValidators(rho.honest) && rho.honest.subset(validators(s.e.electorate))
}

// ── Execution conditions ──

// 時刻 t が環境の時間単位 Δ の整数倍(public time)であることを表す。
// 手書き `PublicTime` の `∃ k : Nat, t = k * E.Δ` に対応し、元の Lean の `E : Env V` は naru では `e : ProtocolEnv` になる。
// k は Nat、t と delta は Int なので `k.toInt()` で持ち上げてから掛ける。
// k は Nat なので、0 < delta のもとでは t は非負になる(0 < delta は SetupWellFormed が要求する)。
// ScheduleWellFormed が「tick は public time にだけ置かれ、public time には必ず tick がある」と書くときに使う。
// 時間単位 Δ は `e.delta` で、0 < delta であることは SetupWellFormed が別に要求する。
condition PublicTime(e: ProtocolEnv, t: Time) { exists k: Nat { t == k.toInt() * e.delta } }

// 実行 rho のイベント列が event key(時刻、同時刻なら phase)の昇順に並んでいることを表す。
// 手書き `ScheduleWellFormed.sorted` の `rho.events.Pairwise (fun e f => e.key ≤ f.key)` に対応する。
// naru には Pairwise が無いので、添字 i < j の 2 要素を `get?` で取り出して `eventKey` を比べる形に展開する。
// どちらかの添字が列の外なら比較せず true とし、範囲内の組だけが制約を受ける。
// 同時刻のイベントの順序は eventKey の phase が決めるので、同時刻の組は phase の昇順で並ぶ。
// ScheduleWellFormed / UnforgeableRun / RunWellFormed が共有する欄で、
// 手書き `UnforgeableRun.sorted` / `RunWellFormed.sorted` も同じ形である。
condition EventsSorted(rho: NamedRun) {
  forall i: Nat { forall j: Nat {
    i < j implies match (rho.events.get?(i), rho.events.get?(j)) {
      (Some(a), Some(b)) => eventKey(a) <= eventKey(b),
      _ => true,
    }
  } }
}

// 実行 rho のイベント列に重複が無いことを表す。
// 手書き `ScheduleWellFormed.nodup` の `rho.events.Nodup` に対応し、添字 i < j の 2 要素が等しくないという量化で書く。
// 範囲外の添字の組は比べず true とするので、列の中の組だけが制約を受ける。
// 等しい 2 つのイベントが別の位置にあることを禁じる(同じ配送や tick の重複を排除する)。
// ScheduleWellFormed の欄の一つで、EventsSorted と同様に `get?` で添字を取り出す。
// 手書きでは別の定義にならず構造体の欄だが、naru では ScheduleWellFormed を読みやすくするため切り出す。
condition EventsNodup(rho: NamedRun) {
  forall i: Nat { forall j: Nat {
    i < j implies match (rho.events.get?(i), rho.events.get?(j)) {
      (Some(a), Some(b)) => a != b,
      _ => true,
    }
  } }
}

// 実行 rho のすべてのイベントが honest な node で起きることを表す。
// 手書き `ScheduleWellFormed.honest_only` の `∀ e ∈ rho.events, e.node ∈ rho.honest` に対応し、`eventNode` で node を取る。
// 手書き `UnforgeableRun.honest_only` も同じ欄で、ScheduleWellFormed と UnforgeableRun が共有するので切り出してある。
// 偽のイベントは実行に含まれないという前提であり、悪意ある validator の挙動は署名の偽造不能性などで別に扱う。
// 本体は「イベントの列に含まれる ev について、その node が rho.honest に入る」という含意だけである。
// 対象は NamedEvent で、honest 集合は rho.honest である。
condition HonestOnly(rho: NamedRun) {
  forall ev: NamedEvent { rho.events.contains(ev) implies rho.honest.contains(eventNode(ev)) }
}

// イベントの予定表が、整列済み・有限・honest のみ・public time で全域であることを表す。
// 手書き `ScheduleWellFormed` の 7 欄(horizon_nonneg / sorted / nodup / in_horizon / honest_only / tick_public /
// tick_total)を
// `&&` で束ねる。sorted / nodup / honest_only は EventsSorted / EventsNodup / HonestOnly に切り出して呼ぶ。
// in_horizon は各イベントの時刻が [0, horizon] に入ること、tick_public は tick の時刻が PublicTime であること。
// tick_total は honest な v と horizon までの非負の public time t のすべてに `Tick(v, t)` があること。
// 手書きが取る `E : Env V` は naru では設定 s で、PublicTime には `s.e` を渡す。
// ExecutionValid の一部である。
condition ScheduleWellFormed(s: Setup, rho: NamedRun) {
  0 <= rho.horizon
    && EventsSorted(rho)
    && EventsNodup(rho)
    && (forall ev: NamedEvent {
         rho.events.contains(ev) implies 0 <= eventTime(ev) && eventTime(ev) <= rho.horizon
       })
    && HonestOnly(rho)
    && (forall v: ValidatorId { forall t: Time {
         rho.events.contains(NamedEvent.Tick(v, t)) implies PublicTime(s.e, t)
       } })
    && (forall v: ValidatorId { forall t: Time {
         rho.honest.contains(v) && PublicTime(s.e, t) && 0 <= t && t <= rho.horizon
           implies rho.events.contains(NamedEvent.Tick(v, t))
       } })
}

// 配送されたオブジェクトが、形式・依存・新規性の検査を満たすことを表す。
// 手書き `DeliveryWellFormed` の 3 欄(wire / deps / fresh)を `&&` で束ねる。i 番目のイベントが `Deliver(v, o, t)` のとき、
// wire は `wellFormed(o)`、deps は i 番目の直前の v の状態で `depsPresent`、fresh は同じ状態で `!processed` が成り立つこと。
// 元の Lean の `Run.stateBefore P rho i v` は、naru では `worldAt(stateBefore(s, rho, i), v).st` と書く。
// 手書きは run が一般の P.Object 上だが、naru は名前付きの run なので設定 s を取る。
// ExecutionValid の一部で、配送イベントだけを制約する。
condition DeliveryWellFormed(s: Setup, rho: NamedRun) {
  forall i: Nat { forall v: ValidatorId { forall o: NamedObject { forall t: Time {
    rho.events.get?(i) == Some(NamedEvent.Deliver(v, o, t)) implies
      wellFormed(o)
        && depsPresent(worldAt(stateBefore(s, rho, i), v).st, o)
        && !processed(worldAt(stateBefore(s, rho, i), v).st, o)
  } } } }
}

// 署名が偽造不能であることを表す。honest な validator の作と見なされるオブジェクトは、その validator が発行したものである。
// 手書き `UnforgeableSignatures` の 2 欄(unforgeable / carried)に対応し、`&&` で束ねる。
// 前半は v が時刻 t に処理したオブジェクト o の author が honest な u なら、t 以前に u が発行(Emits)したこと。
// 後半は処理した o が運ぶ(Carries)o2 についても、author が honest な u なら t 以前に u が発行したこと。
// 元の Lean の `P.author o = some u` は `author(o) == Some(u)`、`Run.processes` / `Run.emits` は Processes / Emits になる。
// 手書きの型 P.Object は naru では NamedObject で、設定 s を引数に取る。
condition UnforgeableSignatures(s: Setup, rho: NamedRun) {
  (forall v: ValidatorId { forall o: NamedObject { forall t: Time {
    Processes(s, rho, v, o, t) implies
      forall u: ValidatorId {
        rho.honest.contains(u) && author(o) == Some(u) implies exists t2: Time { t2 <= t && Emits(s, rho, u, o, t2) }
      }
  } } })
    && (forall v: ValidatorId { forall o: NamedObject { forall t: Time {
         Processes(s, rho, v, o, t) implies
           forall o2: NamedObject {
             Carries(o, o2) implies
               forall u: ValidatorId {
                 rho.honest.contains(u) && author(o2) == Some(u)
                   implies exists t2: Time { t2 <= t && Emits(s, rho, u, o2, t2) }
               }
           }
       } } })
}

// 署名が偽造不能で、イベントが整列・honest のみ・horizon が非負の実行であることを表す。
// 手書き `UnforgeableRun` は UnforgeableSignatures を extends し、sorted / honest_only / horizon_nonneg を足した構造体である。
// naru では extends を親の condition の `&&` で表し、足した 3 欄は EventsSorted / HonestOnly / `0 <= rho.horizon` になる。
// 手書きは E と I を引数に取るが欄では使っておらず、naru は設定 s だけを取る。
// 配送や tick の整備までは要求せず、署名に関する議論に必要な最小の実行条件である。
// 本体は UnforgeableSignatures(s, rho) && EventsSorted(rho) && HonestOnly(rho) && 0 <= rho.horizon である。
condition UnforgeableRun(s: Setup, rho: NamedRun) {
  UnforgeableSignatures(s, rho) && EventsSorted(rho) && HonestOnly(rho) && 0 <= rho.horizon
}

// ネットワーク以外の実行の前提と、interface の理想化を合わせた条件である。
// 手書き `ExecutionValid` は ScheduleWellFormed / DeliveryWellFormed / UnforgeableSignatures を extends し、
// 欄 idealization で `I.idealization rho` を足す。naru では 3 つの condition と Idealization(s, rho) を `&&` で束ねる。
// 到達・同期に関する仮定(PartialSynchrony など)は含まず、それらは別の condition として claim に並べる。
// Idealization は Spec/Interface.naru の述語で、実行の block の root が衝突しない(NamedRootCollisionFree)理想化を表す。
// 元の Lean の `I : Interface P` は naru では Interface.naru の宣言群になり、引数には現れない。
condition ExecutionValid(s: Setup, rho: NamedRun) {
  ScheduleWellFormed(s, rho) && DeliveryWellFormed(s, rho) && UnforgeableSignatures(s, rho) && Idealization(s, rho)
}

// 整列済みで horizon が非負の実行が、interface の理想化を満たすことを表す。読み出しは [0, horizon] の時刻で行う。
// 手書き `RunWellFormed` の 3 欄(horizon_nonneg / sorted / idealization)を `&&` で束ねたものである。
// ExecutionValid より弱く、配送の整備や署名の偽造不能性は要求しない(読み出しの主張はそこまで要らない)。
// sorted は EventsSorted、idealization は Idealization(s, rho) に当たる。
// 手書きが取る `E : Env V` と `I : Interface P` は、naru では設定 s にまとまる。
// 読み出しを [0, horizon] の時刻で行うのは使う側の取り決めで、この条件は horizon が非負(区間が空でない)ことだけを要求する。
condition RunWellFormed(s: Setup, rho: NamedRun) {
  0 <= rho.horizon && EventsSorted(rho) && Idealization(s, rho)
}

// 実行から組み立てられた 2 つの certificate の間に evidence が存在しないことを表す。
// 手書き `SlashableBound` の `∀ c c', I.inRun rho c → I.inRun rho c' → ¬ I.evidence c c'` に対応する。
// 元の Lean の `I.inRun` / `I.evidence` は naru では InRun(s, rho, c) / Evidence(s, c, c2) で、c と c2 は NamedBlock である。
// slashable な重みが出ない(責任追及が起きない)実行だけを扱う claim の premise になる。
// 結論側の HasSlashableWeightBetween(Accountability.naru)の否定側の仮定にあたる。
// 全称は NamedBlock の組 c と c2 についてで、c = c2 の場合も含む。
condition SlashableBound(s: Setup, rho: NamedRun) {
  forall c: NamedBlock { forall c2: NamedBlock {
    InRun(s, rho, c) && InRun(s, rho, c2) implies !Evidence(s, c, c2)
  } }
}

// ── Network conditions ──

// 部分同期を表す。broadcast と受理済みオブジェクトの relay が GST 後の上限時間内に完了する。
// ただし期限時点の受信者の状態が除外する(excludes)オブジェクト、つまり受信者の finalized block と衝突する block は除く。
// 手書き `PartialSynchrony` の 2 欄に対応し、`&&` で束ねる。broadcast は honest な v が時刻 t に発行した o について、
// relay は honest な v が i 番目で受理した o について、期限 `max(t, tGST) + Δ` までに honest な w が処理する(HandlesAt)こと。
// relay はさらに w が i+1 番目の直前までに o を未処理であることを前提に置く。どちらも期限が horizon 以内のときだけ要求する。
// 元の Lean の `Run.emits` / `Run.acceptsAt` / `Run.handlesAt` は Emits / AcceptsAt / HandlesAt になる。
condition PartialSynchrony(s: Setup, rho: NamedRun) {
  (forall v: ValidatorId { forall o: NamedObject { forall t: Time {
    rho.honest.contains(v) && Emits(s, rho, v, o, t) implies
      forall w: ValidatorId {
        let deadline = t.max(s.e.tGST) + s.e.delta;
        rho.honest.contains(w)
          && deadline <= rho.horizon
          && !excludes(worldAt(stateBeforeTime(s, rho, deadline), w).st, o)
          implies exists t2: Time { t <= t2 && t2 < deadline && exists j: Nat { HandlesAt(s, rho, j, w, o, t2) } }
      }
  } } })
    && (forall v: ValidatorId { forall i: Nat { forall o: NamedObject { forall t: Time {
         rho.honest.contains(v) && AcceptsAt(s, rho, i, v, o, t) implies
           forall w: ValidatorId {
             let deadline = t.max(s.e.tGST) + s.e.delta;
             rho.honest.contains(w)
               && !processed(worldAt(stateBefore(s, rho, i + 1), w).st, o)
               && deadline <= rho.horizon
               && !excludes(worldAt(stateBeforeTime(s, rho, deadline), w).st, o)
               implies exists t2: Time { t <= t2 && t2 < deadline && exists j: Nat { HandlesAt(s, rho, j, w, o, t2) } }
           }
       } } } })
}

// 有限な健全な接頭辞 [0, cut] の上で、同じ broadcast と relay の保証が成り立つことを表す。除外の扱いも同じである。
// 手書き `HealthyPrefixDelivery` に対応し、PartialSynchrony との違いは期限が `t + Δ` で GST を使わず、`deadline <= cut` が条件な点。
// つまり GST 前の接頭辞でも、cut までの区間で遅延が Δ 以内に収まっていることだけを仮定する。
// 手書きは cut を欄でなく引数に取り、naru も同じく cut: Time を引数に取る。
// 期限 t + Δ は cut を超えない範囲だけを見るので、cut より後のイベントは何も要求されない。
// broadcast は honest な v の発行、relay は受理済みオブジェクトについてで、relay は w の未処理も前提に置く。
condition HealthyPrefixDelivery(s: Setup, rho: NamedRun, cut: Time) {
  (forall v: ValidatorId { forall o: NamedObject { forall t: Time {
    rho.honest.contains(v) && Emits(s, rho, v, o, t) implies
      forall w: ValidatorId {
        let deadline = t + s.e.delta;
        rho.honest.contains(w)
          && deadline <= cut
          && !excludes(worldAt(stateBeforeTime(s, rho, deadline), w).st, o)
          implies exists t2: Time { t <= t2 && t2 < deadline && exists j: Nat { HandlesAt(s, rho, j, w, o, t2) } }
      }
  } } })
    && (forall v: ValidatorId { forall i: Nat { forall o: NamedObject { forall t: Time {
         rho.honest.contains(v) && AcceptsAt(s, rho, i, v, o, t) implies
           forall w: ValidatorId {
             let deadline = t + s.e.delta;
             rho.honest.contains(w)
               && !processed(worldAt(stateBefore(s, rho, i + 1), w).st, o)
               && deadline <= cut
               && !excludes(worldAt(stateBeforeTime(s, rho, deadline), w).st, o)
               implies exists t2: Time { t <= t2 && t2 < deadline && exists j: Nat { HandlesAt(s, rho, j, w, o, t2) } }
           }
       } } } })
}

// ── Participation conditions ──

// 時刻 t に awake な honest validator の集合を返す。
// 手書き `awakeAt` の `H.filter (fun v => E.awake v t = true)` に対応し、`E.awake` は naru では `envAwake(s, v, t)` になる。
// 引数 h は honest 集合で、元の Lean の `E : Env V` は naru では設定 s にまとめる。
fn awakeAt(s: Setup, h: Set<ValidatorId>, t: Time) -> Set<ValidatorId> { h.filter(|v| envAwake(s, v, t)) }

// honest 集合の外にいる validator、つまり faulty な validator の集合を返す。
// 手書きでは全体集合からの差集合 `univ \ H` が各定義の中に直接書かれ、名前付きの定義は無い(手書きに直接の対応物は無い)。
// naru は electorate の validators から h を引く(`diff`)。electorate の外の validator は重みが 0 なので結果に影響しない。
fn faulty(s: Setup, h: Set<ValidatorId>) -> Set<ValidatorId> { validators(s.e.electorate).diff(h) }

// validator v が、半開区間 [a, b) のどこかの時刻で awake な honest validator であることを表す。
// 手書き `awakeIn` の filter の述語(honest かつ区間内に awake な時刻が存在)に対応し、集合ではなく所属の条件で書く。
// 手書き `awakeIn` は述語から集合を作る計算不能な定義で、naru の filter(Bool)では書けないので所属に直した。
// 集合として扱うときは、この所属で集合を特徴付ける AwakeInExactly を使う。
// 区間内の時刻 u は Time(整数)で、awake の判定は `envAwake(s, v, u)` である。
// 区間は半開なので a <= u かつ u < b で、a >= b の空の区間では誰も所属しない。
condition AwakeIn(s: Setup, h: Set<ValidatorId>, a: Time, b: Time, v: ValidatorId) {
  h.contains(v) && exists u: Time { a <= u && u < b && envAwake(s, v, u) }
}

// 集合 w が、[a, b) のどこかで awake な honest validator の集合そのものであることを表す。
// 手書き `awakeIn` の値(集合)を、任意の v について「w の要素であること」と AwakeIn の同値で特徴付けて写したものである。
// 計算不能な集合を関数として返せない代わりに、WindowMajority / FreshMajority が w を存在量化して使う。
// 有限集合なので w は必ず存在し、正規形のもとで一意に決まる。
// 引数は設定 s、honest 集合 h、区間の端 a / b、候補の集合 w である。
// 本体は `forall v { w.contains(v) == AwakeIn(s, h, a, b, v) }` で、w の外の validator も所属しないことを要求する。
condition AwakeInExactly(s: Setup, h: Set<ValidatorId>, a: Time, b: Time, w: Set<ValidatorId>) {
  forall v: ValidatorId { w.contains(v) == AwakeIn(s, h, a, b, v) }
}

// 窓の中で awake だった honest の重みが faulty の重みを上回ることを表す。
// 手書き `WindowMajority` の `weightOf (univ \ H) < weightOf (awakeIn E H (t - w) t)` に対応し、窓の幅 window を引数に取る。
// 手書き `awakeIn` は集合を直接返すが、naru では AwakeInExactly で特徴付けた集合 w を `exists members: List` で量化する。
// List から `toSet()` で作ることで正規形が保証され、重複による重みの二重計上が起きない。
// faulty 側は faulty(s, h) で、重みは `weightOf(s.e.electorate, …)` で測る。
// 窓は半開区間 [t − window, t) で、window は Time の幅である。
condition WindowMajority(s: Setup, h: Set<ValidatorId>, window: Time, t: Time) {
  exists members: List<ValidatorId> {
    let awakeInWindow = members.toSet();
    AwakeInExactly(s, h, t - window, t, awakeInWindow)
      && weightOf(s.e.electorate, faulty(s, h)) < weightOf(s.e.electorate, awakeInWindow)
  }
}

// すべての honest validator が、GST から実行の horizon までのすべての時刻で awake であることを表す。
// 手書き `FullParticipation` の `∀ v ∈ rho.honest, ∀ t, E.t_GST ≤ t → t ≤ rho.horizon → E.awake v t = true` に対応する。
// `E.awake` は naru では `envAwake(s, v, t)`、`E.t_GST` は `s.e.tGST` である。
// 時刻 t の下限は GST で、非負性は SetupWellFormed の `0 <= tGST` から従う。
// 一部の validator が眠る実行を扱う WindowMajority / FreshMajority と対になる、最も強い参加の仮定である。
// 元の Lean の `E.t_GST ≤ t → t ≤ rho.horizon` は、naru では含意の前件 `s.e.tGST <= t && t <= rho.horizon` になる。
condition FullParticipation(s: Setup, rho: NamedRun) {
  forall v: ValidatorId { forall t: Time {
    rho.honest.contains(v) && s.e.tGST <= t && t <= rho.horizon implies envAwake(s, v, t)
  } }
}

// faulty な validator の重みの合計が、全重みの 3 分の 1 未満であることを表す。
// 手書き `BelowOneThird` の `3 * weightOf (univ \ H) < totalWeight` に対応し、除算を避けて 3 倍の形で書く。
// faulty の集合は faulty(s, h)(electorate の外は重み 0)、全重みは `totalWeight(s.e.electorate)` である。
// 安全性に関する claim が、honest 集合 h について置く典型的な仮定である。
// 比較は割り算を使わず、整数の掛け算 3 * (faulty の重み) < 全重み で行う。
// 参加の仮定(FullParticipation など)とは独立で、重みの比だけを見る。
condition BelowOneThird(s: Setup, h: Set<ValidatorId>) {
  3 * weightOf(s.e.electorate, faulty(s, h)) < totalWeight(s.e.electorate)
}

// 停止後の参加(時刻形式)として、時刻 t − lag に awake な honest(fresh)の重みが faulty と stale な honest の重みの合計を上回る。
// stale な honest は、[t − window, t − lag) のどこかで awake だが時刻 t − lag には awake でない honest validator を指す。
// 手書き `FreshMajority` に対応し、手書きが引数 C : Constants から取る participationWindow / participationLag は
// naru では `participationWindow(s)` / `participationLag(s)`(Constants.naru)になる。
// fresh は awakeAt(s, h, t - lag) で、窓の集合は AwakeInExactly で特徴付けた w を `exists members: List` で量化して得る。
// 左辺は faulty に w から fresh を除いた集合を足した集合の重み、右辺は fresh の重みである。
condition FreshMajority(s: Setup, h: Set<ValidatorId>, t: Time) {
  exists members: List<ValidatorId> {
    let awakeInWindow = members.toSet();
    let fresh = awakeAt(s, h, t - participationLag(s));
    AwakeInExactly(s, h, t - participationWindow(s), t - participationLag(s), awakeInWindow)
      && weightOf(s.e.electorate, faulty(s, h).union(awakeInWindow.diff(fresh))) < weightOf(s.e.electorate, fresh)
  }
}

// ── Committee and proposer conditions ──

// すべての slot の committee で、honest が人数で過半数を厳密に超えることを表す。
// 手書き `HonestCommittees` の `(I.committee s).card < 2 * ((I.committee s) ∩ H).card` に対応する。
// 元の Lean の `I.committee` は naru では `committee(k)`(Interface.naru)で、`card` は `size()`、`∩` は `inter` になる。
// 手書きが取る `I : Interface P` は naru では引数に現れず、honest 集合 h だけを取る。
// committee が空でないことは SetupWellFormed が別に要求する。
// 空の committee では 0 < 0 となり成り立たないので、この条件はすべての committee が空でないことを含意する。
condition HonestCommittees(h: Set<ValidatorId>) {
  forall k: Slot { committee(k).size() < 2 * committee(k).inter(h).size() }
}

// opening slot k と、続く proposerSlots − 1 個の slot のすべてで proposer が honest であることを表す。
// 手書き `MultiProposerAt` の `I.opening s ∧ ∀ k < C.proposerSlots, I.proposer (s + k) ∈ H` に対応する。
// 元の Lean の `I.opening` は `Opening(s, k)`(設定 s を取る)、`C.proposerSlots` は `proposerSlots()` になる。
// 連続した複数の slot の proposer が honest な窓を表し、続く 2 段目と 3 段目の recurrence 条件が使う。
// 添字 j は Nat で、slot k + j の proposer が h に入ることを要求する。
// j の範囲は 0 以上 proposerSlots() 未満なので、k 自身(j = 0)も proposer が honest でなければならない。
condition MultiProposerAt(s: Setup, h: Set<ValidatorId>, k: Slot) {
  Opening(s, k) && forall j: Nat { j < proposerSlots() implies h.contains(proposer(k + j)) }
}

// 第 1 段の単独 proposer の反復を表す。t0 以降の任意の時刻 t で、gap 期間の窓が実行内に収まるなら、窓の中に honest な提案がある。
// 提案は t より厳密に後で、窓の終端 `t + gap * period` 以内の slot k の提案時刻に起き、proposer(k) が honest である。
// 手書き `SingleProposerRecurrence` に対応し、`I.proposalTime` は `proposalTime(s.e, k)`、`C.period` は `period(s)` になる。
// 確認済みの成長(confirmed growth)にはこれ以上の仮定は要らない。
// gap は Nat なので Int の時刻に足すとき `gap.toInt()` で持ち上げる。
// 続く第 2 段(MultiProposerRecurrence)と第 3 段(StrongMultiProposerRecurrence)はこの条件を強めたものである。
condition SingleProposerRecurrence(s: Setup, rho: NamedRun, t0: Time, gap: Nat) {
  forall t: Time {
    t0 <= t && t + gap.toInt() * period(s) <= rho.horizon implies
      exists k: Slot {
        t < proposalTime(s.e, k) && proposalTime(s.e, k) <= t + gap.toInt() * period(s)
          && rho.honest.contains(proposer(k))
      }
  }
}

// 第 2 段の複数 proposer の反復を表す。start 以降の任意の時刻から gap 期間以内に、複数 proposer の窓が始まる。
// 窓は opening slot と続く proposerSlots − 1 個の slot がすべて honest な proposer を持つもの(MultiProposerAt)で、recovery が使う。
// 手書き `MultiProposerRecurrence` に対応し、窓の終端 `t + gap * period` が horizon 以内に収まる t だけが対象になる。
// 窓に何も置けない t(終端が horizon を超える)には要求せず、実行の末尾で条件が不当に厳しくならない。
// 提案時刻は t より厳密に後で終端以内の slot k を探し、k で MultiProposerAt(s, rho.honest, k) が成り立つ。
// 第 1 段(SingleProposerRecurrence)より強く、第 3 段(StrongMultiProposerRecurrence)より弱い。
condition MultiProposerRecurrence(s: Setup, rho: NamedRun, start: Time, gap: Nat) {
  forall t: Time {
    start <= t && t + gap.toInt() * period(s) <= rho.horizon implies
      exists k: Slot {
        t < proposalTime(s.e, k) && proposalTime(s.e, k) <= t + gap.toInt() * period(s)
          && MultiProposerAt(s, rho.honest, k)
      }
  }
}

// 第 3 段の強い複数 proposer の反復を表す。第 2 段に加え、その窓の直前 2 期間のすべての opening も honest な proposer を持つ。
// finality が使う。手書き `StrongMultiProposerRecurrence` に対応し、窓の終端が horizon 以内に収まる start 以降の t だけが対象になる。
// 提案時刻は `t + 2 * period` 以上かつ `t + gap * period` 以下の slot k で、MultiProposerAt が成り立つ。
// 第 2 段との違いは、提案時刻の下限が t を超えるだけでなく `t + 2 * period` 以上に引き上げられている点である。
// さらに提案時刻が [提案時刻(k) − 2 period, 提案時刻(k)) に入るすべての opening k2 の proposer が honest である。
// 手書きの注記では、連続時間で成立しうる最小の強い gap は 3 で、finality の claim が空でなくなるのは gap >= 3(K >= 5)である。
condition StrongMultiProposerRecurrence(s: Setup, rho: NamedRun, start: Time, gap: Nat) {
  forall t: Time {
    start <= t && t + gap.toInt() * period(s) <= rho.horizon implies
      exists k: Slot {
        t + 2 * period(s) <= proposalTime(s.e, k)
          && proposalTime(s.e, k) <= t + gap.toInt() * period(s)
          && MultiProposerAt(s, rho.honest, k)
          && forall k2: Slot {
               Opening(s, k2)
                 && proposalTime(s.e, k) - 2 * period(s) <= proposalTime(s.e, k2)
                 && proposalTime(s.e, k2) < proposalTime(s.e, k)
                 implies rho.honest.contains(proposer(k2))
             }
      }
  }
}
