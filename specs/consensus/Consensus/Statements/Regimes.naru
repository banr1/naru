// verified-consensus の移植: DecoupledConsensusStatements/Generic/Regimes.lean(`AgreesUntil` / `Continues` / `BFTRegime` /
// `RecoveryRegime` / `RecoveredBy` / `AccountableRegime` / `SleepyRegime` / `LiveSleepyRegime` / `FreshSleepyRegime` /
// `FinalityRegime` / `OutageRegime`)。
//
// - `structure … : Prop where` → `&&` で束ねた regime、`extends` → 親の regime を `&&` に含める。
// - `inductive RecoveredBy … | genesis | recovered …` は再帰しない(genesis か、1 回の recovery prefix の継続)ので、
//   `t == 0 || exists source, t0, gap { … }` と書く(knowledge「手書き Statements の構成」)。量化される `source` には、
//   手書きの型が保証する run の領域 `RunDomain(s, source)`(Conditions.naru)を足す。
// - `rho'.honest ⊆ rho.honest` → `subset`、`rho'.events.filter (fun e => decide (…)) = …` → `filter` の List の等しさ。
module Consensus.Statements.Regimes

import Consensus.Objects.Identifiers
import Consensus.Objects.Time
import Consensus.Objects.Parameters
import Consensus.Execution.Setup
import Consensus.Execution.Run
import Consensus.Statements.Interface
import Consensus.Statements.Constants
import Consensus.Statements.Conditions

// A continuation preserves retained honest validators' event prefixes.
regime AgreesUntil(rho: NamedRun, rho2: NamedRun, cutoff: Time) {
  rho2.honest.subset(rho.honest)
    && forall v: ValidatorId {
         rho2.honest.contains(v) implies
           rho2.events.filter(|ev| eventNode(ev) == v && eventTime(ev) < cutoff)
             == rho.events.filter(|ev| eventNode(ev) == v && eventTime(ev) < cutoff)
       }
}

// A continuation agrees before `cut` and reaches `upto`. The event comparison uses the half-open prefix `time < cut`.
regime Continues(source: NamedRun, rho: NamedRun, cut: Time, upto: Time) {
  AgreesUntil(source, rho, cut) && upto <= rho.horizon
}

// Execution and partial synchrony with a below-one-third, fully awake electorate.
regime BFTRegime(s: Setup, rho: NamedRun, t0: Time) {
  ExecutionValid(s, rho)
    && PartialSynchrony(s, rho)
    && s.e.tGST <= t0
    && HonestCommittees(rho.honest)
    && BelowOneThird(s, rho.honest)
    && FullParticipation(s, rho)
}

// A bounded recovery prefix with proposer recurrence and a protocol-specific horizon.
regime RecoveryRegime(s: Setup, rho: NamedRun, t0: Time, gap: Nat) {
  BFTRegime(s, rho, t0)
    && MultiProposerRecurrence(s, rho, s.e.tGST, gap)
    && rho.horizon == prefixEnd(s, t0, gap)
}

// The run is recovered at genesis or after a bounded recovery prefix.
regime RecoveredBy(s: Setup, rho: NamedRun, t: Time) {
  t == 0
    || exists source: NamedRun { exists t0: Time { exists gap: Nat {
         RunDomain(s, source)
           && RecoveryRegime(s, source, t0, gap)
           && Continues(source, rho, prefixEnd(s, t0, gap), recoveryEnd(s, t0, gap))
           && SlashableBound(s, rho)
           && t == recoveryEnd(s, t0, gap)
       } } }
}

// The accountable regime: a well-formed run without one-third-slashable evidence.
regime AccountableRegime(s: Setup, rho: NamedRun) { RunWellFormed(s, rho) && SlashableBound(s, rho) }

// The sleepy regime from `t0`: validity, partial synchrony after GST ≤ t0, honest committees, a fresh-window majority at
// every time from `t0`, and a sound start (genesis or a completed recovery).
regime SleepyRegime(s: Setup, rho: NamedRun, t0: Time) {
  ExecutionValid(s, rho)
    && PartialSynchrony(s, rho)
    && s.e.tGST <= t0
    && HonestCommittees(rho.honest)
    && (forall t: Time {
         t0 <= t && participationLag(s) <= t && t - participationLag(s) <= rho.horizon
           implies WindowMajority(s, rho.honest, participationWindow(s), t)
       })
    && RecoveredBy(s, rho, t0)
}

// A live sleepy regime with tier-1 single-proposer recurrence from `t0`.
regime LiveSleepyRegime(s: Setup, rho: NamedRun, t0: Time, gap: Nat) {
  SleepyRegime(s, rho, t0) && SingleProposerRecurrence(s, rho, t0, gap)
}

// A fresh sleepy regime from `t0`: the sleepy regime, and a fresh majority at every time from `t0` whose reference sample
// is in the run.
regime FreshSleepyRegime(s: Setup, rho: NamedRun, t0: Time) {
  SleepyRegime(s, rho, t0)
    && forall t: Time {
         t0 <= t && participationLag(s) <= t && t - participationLag(s) <= rho.horizon
           implies FreshMajority(s, rho.honest, t)
       }
}

// The finality regime from `t0`: BFT premises, strong recurrence from GST within `gap ≤ maxGap − 2` periods, and a run
// long enough to contain the startup.
regime FinalityRegime(s: Setup, rho: NamedRun, t0: Time, gap: Nat) {
  BFTRegime(s, rho, t0)
    && StrongMultiProposerRecurrence(s, rho, s.e.tGST, gap)
    && gap + 2 <= maxGap(s)
    && t0 + finalityStartup(s, gap) <= rho.horizon
}

// The outage regime for a stable read at `tRead` and the half-open outage window [b0, b1). The interval fields also record
// the boundary needed for delivery after the window.
regime OutageRegime(s: Setup, rho: NamedRun, tRead: Time, b0: Time, b1: Time) {
  ExecutionValid(s, rho)
    && PartialSynchrony(s, rho)
    && s.e.tGST <= b1
    && HonestCommittees(rho.honest)
    && HealthyPrefixDelivery(s, rho, b0)
    && 0 <= b0 && b0 <= b1 && b1 <= rho.horizon
    && PublicTime(s.e, b0)
    && (forall t: Time {
         participationLag(s) <= t && t <= rho.horizon + participationLag(s) implies FreshMajority(s, rho.honest, t)
       })
    && SlashableBound(s, rho)
    && outageStart(s, tRead) <= b0 && b1 + s.e.delta <= expiry(s, tRead) && b1 + s.e.delta <= rho.horizon
}
