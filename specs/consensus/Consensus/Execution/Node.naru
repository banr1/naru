// verified-consensus の移植: DecoupledConsensusModel/Execution/Node.lean(execution — the node profile, its receipt for one
// event, and the node state transition)。手書きの `NamedProfile.tick` / `NamedReceipt`(`wellFormed` `depsPresent` `processed`
// `excludes` `process`)/ `NamedNodeState` / `NamedNode`(`initial` `tick` `process`)に対応する。
//
// - `NamedProfile.gradeContract cache = frameContract cache` は naru では `c: Cache` そのもの(Grades.naru の冒頭)。
// - `NamedReceipt.wellFormed S o` は `S.E.committee` しか読まないので `s` を取らず `input committee` を読む。
// - `Execution/Instance.lean` の `spec`(`Generic.ProtocolSpec` の instance: `State` / `Object` / `init` / `tick` / `process` /
//   `author` / `wellFormed` / `depsPresent` / `processed` / `excludes` と Prop の `handles` / `carries`)は、これらの fn を束ねる
//   naru の `protocol` 宣言に対応する。計算可能な hook はここに揃っており、`protocol` 宣言と stdlib の Run への結び付けは
//   C7 の経路(scenario / observer / simulate)を決める周回で書く。`handles` / `carries` は Prop なので Statements。
// - 改名: `NamedNode.initial` / `tick` / `process` → `initialNode` / `nodeTick` / `nodeProcess`(`tick` は Protocol.Tick の名前)、
//   `NamedReceipt.process` → `receiptProcess`。
module Consensus.Execution.Node

import Consensus.Objects.Identifiers
import Consensus.Objects.Time
import Consensus.Objects.Blocks
import Consensus.Objects.NamedBlocks
import Consensus.Objects.Parameters
import Consensus.Protocol.Schedule
import Consensus.Protocol.Grades
import Consensus.Protocol.ValidatorClient
import Consensus.Protocol.Store
import Consensus.Protocol.Handlers
import Consensus.Protocol.Tick
import Consensus.Execution.Objects
import Consensus.Execution.Setup

// ── NamedProfile: closed named behavior with the supplied Setup unchanged ──

// 既存の名前付き tick を、渡された Setup を変えずに 1 回だけ呼ぶ。
// 引数は Setup s、準備済みの phase キャッシュ c、validator v、名前付き store st、署名 record rec、時刻 t である。
// 環境 s.e・healing 設定 s.hc・高さ設定 s.cfg・node(setupNode(v))をそのまま tick に渡し、
// 返る (store, record, 出力オブジェクト列) を欠かさず返す。
// 手書き `NamedProfile.tick` に対応する。手書き `NamedProfile.gradeContract` は naru では c(Cache)そのものなので渡す引数で済む。
fn profileTick(s: Setup, c: Cache, v: ValidatorId, st: NamedStore, rec: NamedRecord, t: Time)
    -> (NamedStore, NamedRecord, List<NamedObject>) {
  tick(c, s.e, s.hc, s.cfg, setupNode(v), st, rec, t)
}

// ── NamedReceipt: full named ingress checks and closed local dispatch ──

// 名前付きオブジェクトが wire 形として整っているかを、既存の 3 つの検査で判定する。
// ブロックは消去した幾何(eraseBlock)について、運ばれる投票・support の形と、
// 含まれる Goldfish 投票の作成者が各 slot の committee に属することを調べる。
// 投票は voteWellFormed、attestation 行は常に true である。
// 手書き `NamedReceipt.wellFormed` に対応する。手書きは Setup を取るが、読むのは committee だけなので
// naru では s を取らず input の committee を読む。
fn wellFormed(o: NamedObject) -> Bool {
  match o {
    NamedObject.Block(b) => {
      let geometry = eraseBlock(b);
      carriedVotesWellFormed(geometry) && carriedSupportWellFormed(geometry)
        && gfVotes(geometry).all(|u| committee(u.slot).contains(u.valIndex))
    },
    NamedObject.GfVote(u) => voteWellFormed(u),
    NamedObject.Attest(_) => true,
  }
}

// オブジェクトの依存が store に揃っているかを返す。
// ブロックは名前付きの親ブロックそのものが st.bodies に含まれることを要求する。
// 投票と attestation 行は依存を要求せず常に true で、投票の解決は後段の読みで行う。
// 手書き `NamedReceipt.depsPresent` に対応する。
fn depsPresent(st: NamedStore, o: NamedObject) -> Bool {
  match o {
    NamedObject.Block(b) => st.bodies.contains(namedParent(b)),
    NamedObject.GfVote(_) => true,
    NamedObject.Attest(_) => true,
  }
}

// オブジェクトが store に受理済みかを、元の名前付き行まで含めて判定する。
// ブロックは st.bodies に含まれること、投票は slot の pool(storePool)に含まれること、
// attestation は round ごとの sgRows に含まれることを調べる。
// 手書き `NamedReceipt.processed` に対応する。
fn processed(st: NamedStore, o: NamedObject) -> Bool {
  match o {
    NamedObject.Block(b) => st.bodies.contains(b),
    NamedObject.GfVote(u) => storePool(st.core, u.slot).contains(u),
    NamedObject.Attest(a) => st.sgRows.getOr(a.round, []).contains(a),
  }
}

// node の finalized ブロックと衝突するブロック(互いに祖先でない)が永久に除外されるかを返す。
// finality は延びるだけなので、一度衝突したブロックは二度と受理されない。
// 判定は compatible(st.core.f, eraseBlock(b)) の否定で、投票と attestation は除外されず常に false である。
// 手書き `NamedReceipt.excludes` に対応する。
fn excludes(st: NamedStore, o: NamedObject) -> Bool {
  match o {
    NamedObject.Block(b) => !compatible(st.core.f, eraseBlock(b)),
    NamedObject.GfVote(_) => false,
    NamedObject.Attest(_) => false,
  }
}

// 受信したオブジェクト 1 つを store に反映した新しい名前付き store を返す。
// ブロックは運ばれた行も受理する(`AlsoCarried`)onBlockWith に s.cfg を変えずに渡す。
// 投票は onGoldfishVoteChecked で core を更新し、attestation は admitRow で行を受理する。
// 手書き `NamedReceipt.process` に対応する。naru の大域名は 1 つの表なので、手書き `NamedNode.process`(naru の nodeProcess)と
// 同じ `process` になるのを避けて receiptProcess と改名した。
fn receiptProcess(s: Setup, st: NamedStore, o: NamedObject) -> NamedStore {
  match o {
    NamedObject.Block(b) => onBlockWith(CarriedAdmission.AlsoCarried, s.e, s.hc, s.cfg, st, b),
    NamedObject.GfVote(u) => NamedStore { core: onGoldfishVoteChecked(st.core, u), ..st },
    NamedObject.Attest(a) => admitRow(s.hc, st, a),
  }
}

// ── NamedNode: one named node with the existing phase cache ──

// 名前付き node 1 つの状態を表す record である。
// 欄 st は名前付き store、signing は署名 record、cache は phase キャッシュ(Cache)である。
// 手書き `NamedNodeState` に対応し、手書きの欄 record は naru の予約語なので signing と改名した
// (`rec` は Lean の生成名なので避けた)。
// run の World はこの状態を validator ごとに持つ(Run.naru の NamedWorld)。
// st と cache は tick と受信(nodeTick / nodeProcess)で更新され、signing は tick でだけ更新される(受信では保たれる)。
// cache は更新のたびに finalized ブロックで clip される。
record NamedNodeState { st: NamedStore, signing: NamedRecord, cache: Cache } derive eq

// node の初期状態を返す。名前付き store・署名 record・phase キャッシュをそれぞれの初期値にする。
// 手書き `NamedNode.initial` に対応し、tick と衝突しないよう initialNode と改名した。
// 引数は取らず、Run.naru の worldAt が未登録の validator に返す既定の状態として使う。
fn initialNode() -> NamedNodeState {
  NamedNodeState { st: initialNamedStore(), signing: initialNamedRecord(), cache: initialCache() }
}

// node に時刻 t の tick を 1 回与え、新しい node 状態と出力オブジェクト列を返す。
// まず受け取った store から onPhaseTick で phase を完了させたキャッシュ c を作り、
// profileTick を 1 回呼ぶ。新しいキャッシュは、返った store の finalized ブロックで c を clipCache した結果になる。
// 手書き `NamedNode.tick` に対応し、Protocol.Tick の tick との衝突を避けて nodeTick と改名した。
fn nodeTick(s: Setup, v: ValidatorId, n: NamedNodeState, t: Time) -> (NamedNodeState, List<NamedObject>) {
  let c = onPhaseTick(s.e, s.hc, storeToHealing(n.st.core), t, n.cache);
  match profileTick(s, c, v, n.st, n.signing, t) {
    (st, rec, out) => (NamedNodeState { st: st, signing: rec, cache: clipCache(st.core.f, c) }, out),
  }
}

// node がオブジェクト o を受信したときの新しい node 状態を返す。
// store は receiptProcess で更新し、署名 record はそのまま保ち、キャッシュは新しい finalized ブロックで clipCache する。
// 手書き `NamedNode.process` に対応し、nodeProcess と改名した。
fn nodeProcess(s: Setup, n: NamedNodeState, o: NamedObject) -> NamedNodeState {
  let st = receiptProcess(s, n.st, o);
  NamedNodeState { st: st, signing: n.signing, cache: clipCache(st.core.f, n.cache) }
}
