// verified-consensus の移植: DecoupledConsensusModel/Objects/Identifiers.lean(§1 識別子)。
// 手書き Model の `Slot` / `Height` / `Round` / `BlockId` / `genesisRoot` に対応する。
// BlockId は単なる識別子でよい(IDEAL.md「理想化」)。手書きの `LinearOrder BlockId` は `value` で持ち上げた
// 全順序なので、`derive order`(欄の辞書式順序)がそれに一致する。
module Consensus.Objects.Identifiers

// §1 slot number
type Slot = Nat

// §4 height: the finality counter, separate from slot
type Height = Nat

// §3 round index; round r is slots rR … rR+R−1
type Round = Nat

// §1 B.root: the nominal block identity. Roots are opaque; only equality and the fixed order are used.
record BlockId { value: Nat } derive eq, order

// §1 the root of B_gen: the model fixes the least root, so genesis loses every root tie-break
fn genesisRoot() -> BlockId { BlockId { value: 0 } }

// 手書き Model の型引数 `V`(validator の型。Witnesses では `Fin n`)は naru では具体的な識別子に固定する。
// naru には型引数付きの宣言が無く、Model が V に要るのは等しさと(集合の正規化のための)順序だけなので、
// `Fin n` の値は `value` で写せる(golden test はこの対応で手書き Model と突き合わせる)。
record ValidatorId { value: Nat } derive eq, order
