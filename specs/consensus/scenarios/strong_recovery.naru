// naru の実行 fixture(C10): verified-consensus の Witnesses の StrongRecovery(rho 30)に対応する run。
// `lake exe naru simulate specs/consensus/scenarios/strong_recovery.naru`。
//
// - StrongRecovery: Δ = 1、GST 1、proposer 0、committee {0}、重み 3 / 1、R = 3、η = 2、K = 4、D = 2、timeout 6、new_root(s) = s + 1、
//   全 node が awake、node 0 の tick が t = 0 … 30(31 tick。配達は無い)。WeakGenesis との差は GST・重み・awake。
// - Setup と run は fn `strongRecoverySetup` / `strongRecoveryRun` で公開する(golden test `tests/golden/Golden.lean` が使う。C10)。
// - 期待値(tests/golden/protocol_generated.lean の StrongRecovery の読み。周回 10 で手書き Model と一致): 単独の node 0 の読みは
//   WeakGenesis と同じ列になる — confirmed は t = 10 / 14 / 18 / 22 / 26 / 30 で root 2 … 7、stable は t = 26 から root 4、finalized は 0。
module Scenarios.StrongRecovery

import Consensus.Objects.Identifiers
import Consensus.Objects.Time
import Consensus.Objects.Blocks
import Consensus.Objects.Weights
import Consensus.Objects.Parameters
import Consensus.Protocol.Grades
import Consensus.Protocol.ChainState
import Consensus.Execution.Setup
import Consensus.Execution.Run
import Scenarios.Trace

// StrongRecovery の Setup(環境・回復設定・高さ設定)を組み立てて返す。
// 引数は無い。Δ = 1、GST 1、重みは validator 0 が 3、validator 1 が 1、R = 3、η = 2、K = 4、D = 2、timeout 6 を固定値で与える。
// 手書き `S` の `E` / `hc` / `cfg` に写る。WeakGenesis との差は GST と重みで、awake は Setup でなく scenario の input。
fn strongRecoverySetup() -> Setup {
  let v0 = ValidatorId { value: 0 };
  let v1 = ValidatorId { value: 1 };
  let noWeights: Table<ValidatorId, Nat> = Table.empty();
  let electorate = Electorate { weight: noWeights.insert(v0, 3).insert(v1, 1) };
  Setup {
    e: ProtocolEnv { delta: 1, tGST: 1, electorate: electorate },
    hc: HealConfig { r: 3, etaSG: 2 },
    cfg: HeightConfig { k: 4, d: 2, timeoutDelay: 6 }
  }
}

// StrongRecovery の rho 30 に当たる run を返す: node `v0` が t = 0 … 30 に tick するだけで、配達は無い。
// 引数 `v0` は tick する node の ValidatorId。戻り値は honest = {v0}、horizon = 30、events = 31 個の Tick の NamedRun。
// 手書き `rho`(引数 N = 30)と `events` / `tickEvents` が作る tick 列と同じ。golden test(tests/golden/Golden.lean)も使う(C10)。
fn strongRecoveryRun(v0: ValidatorId) -> NamedRun {
  NamedRun { honest: Set.singleton(v0), horizon: 30, events: List.range(31).map(|t| NamedEvent.Tick(v0, t.toInt())) }
}

// StrongRecovery(rho 30)の run を移植 protocol で動かし、各 tick の後の読みと t = 30 の保持 block・読みを表示する scenario。
// input: proposer は全 slot で validator 0、committee は全 slot で {validator 0}、newRoot は slot + 1 を root とする BlockId。
// input: awake は全 node で true(手書き `nd` の awake := fun _ => true。WeakGenesis は node 0 だけ)。
// 手書き `E` の proposer / committees、手書き `nd` の new_root / awake に対応する。
// observe: `trace` が各 event 後の読み、`heldAt` が t = 30 に body を持つ block の root、`readsAt` が t = 30 の読みを出す。
// 単独の node 0 の読みは WeakGenesis と同じ列になる(confirmed は t = 10 … 30 で root 2 … 7、stable は t = 26 から root 4、finalized は 0)。
scenario strongRecovery {
  input proposer(slot) = ValidatorId { value: 0 };
  input committee(slot) = Set.singleton(ValidatorId { value: 0 });
  input newRoot(node, slot) = BlockId { value: slot + 1 };
  input awake(node, round) = true;
  let v0 = ValidatorId { value: 0 };
  let s = strongRecoverySetup();
  let rho = strongRecoveryRun(v0);
  observe trace(s, rho, v0);
  observe heldAt(s, rho, v0, 30);
  observe readsAt(s, rho, v0, 30);
}
