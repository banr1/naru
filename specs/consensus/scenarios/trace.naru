// scenario 共通の observer(C7 / C10): run を移植した protocol(specs/consensus/Consensus)で畳み込み、client-facing な読みだけを表示する。
// state を直接 dump しない(IDEAL.md 用語「observer」)。各 scenario(basic / outage / strong_recovery / two_nodes)はこれを使う。
//
// - `trace(s, rho, v)`: run の各 event の後の node `v` の読み(confirmed / stable / finalized の root)、event 順に 1 行ずつ。
// - `readsAt(s, rho, v, t)`: 時刻 `t` までの event を畳み込んだ後の node `v` の読み(手書き `Run.storeAt` の読み)。
// - `heldAt(s, rho, v, t)`: 時刻 `t` までに node `v` が body を持つ block の root(昇順)。配達が届いたことを見る。
// - `deliveries(rho)`: run の配達 event の数(手書き `Run.objects`。自分が emit した object は数えない)。
// - `votesHeldAt(s, rho, v, k, t)`: 時刻 `t` までに node `v` が slot `k` の pool に持つ Goldfish vote の数(手書き `(st.pool k).card`)。
// - `equivocatorsAt(s, rho, v, k, t)`: その pool で equivocate している validator(昇順。手書き `raw_equivocators (st.pool k)`)。
module Scenarios.Trace

import Consensus.Objects.Identifiers
import Consensus.Objects.Time
import Consensus.Objects.Blocks
import Consensus.Protocol.Store
import Consensus.Protocol.ForkChoice.Goldfish
import Consensus.Protocol.Handlers
import Consensus.Protocol.Duties.Proposals
import Consensus.Execution.Setup
import Consensus.Execution.Run

// One line of the simulation output: a node's client-facing reads after every event up to and including `time`.
record Observation { time: Time, node: ValidatorId, confirmed: BlockId, stable: BlockId, finalized: BlockId } derive eq

// The reads of node `v` in world `w` at time `t` (the roots of the confirmed / stable tips and of the finalized block).
fn observeWorld(w: NamedWorld, v: ValidatorId, t: Time) -> Observation {
  let st = worldAt(w, v).st;
  Observation {
    time: t, node: v,
    confirmed: root(getConfirmed(st.core)), stable: root(getStable(st.core)), finalized: root(st.core.f)
  }
}

// One event folded into the scan: the world after it, and the rows so far plus node `v`'s reads after it.
fn traceStep(s: Setup, v: ValidatorId, acc: (NamedWorld, List<Observation>), ev: NamedEvent) -> (NamedWorld, List<Observation>) {
  match acc {
    (w, rows) => {
      let next = worldStep(s, w, ev);
      (next, rows.push(observeWorld(next, v, eventTime(ev))))
    },
  }
}

// The reads of node `v` after each event of the run, in event order (one scan of the run).
observer trace(s: Setup, rho: NamedRun, v: ValidatorId) -> List<Observation> {
  let start: (NamedWorld, List<Observation>) = (worldInit(), []);
  match rho.events.fold(start, |acc, ev| traceStep(s, v, acc, ev)) {
    (_, rows) => rows,
  }
}

// The reads of node `v` after every event up to and including time `t` (手書き `Run.storeAt` の読み)。
observer readsAt(s: Setup, rho: NamedRun, v: ValidatorId, t: Time) -> Observation {
  let st = storeAt(s, rho, v, t);
  Observation {
    time: t, node: v,
    confirmed: root(getConfirmed(st.core)), stable: root(getStable(st.core)), finalized: root(st.core.f)
  }
}

// The roots of the blocks node `v` holds the body of after every event up to and including time `t`, ascending
// (手書き `(st.bodies.image NamedBlock.root).sort (· ≤ ·)`)。
observer heldAt(s: Setup, rho: NamedRun, v: ValidatorId, t: Time) -> List<BlockId> { orderedRoots(storeAt(s, rho, v, t)) }

// The number of delivery events of the run (手書き `Run.objects`: payloads of deliveries only).
observer deliveries(rho: NamedRun) -> Nat { runObjects(rho).size() }

// The number of slot-`k` Goldfish votes node `v` holds after every event up to and including time `t` (手書き `(st.pool k).card`).
observer votesHeldAt(s: Setup, rho: NamedRun, v: ValidatorId, k: Slot, t: Time) -> Nat {
  storePool(storeAt(s, rho, v, t).core, k).size()
}

// The validators that equivocate in node `v`'s slot-`k` pool after every event up to and including time `t`, ascending
// (手書き `raw_equivocators (st.pool k)`: two distinct votes of theirs are held).
observer equivocatorsAt(s: Setup, rho: NamedRun, v: ValidatorId, k: Slot, t: Time) -> List<ValidatorId> {
  sort(rawEquivocators(storePool(storeAt(s, rho, v, t).core, k)), by = |x| x)
}
