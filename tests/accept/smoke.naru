// 受理例: MVP 構文の一通り。`lake exe naru compile tests/accept/smoke.naru` が exit 0 になること。
// 名前解決・phase 検査(E001)・型検査・capability 検査・Set の選択(E003)/順序(E004)の検査をすべて通る。
module Accept.Smoke

type Slot = Nat
type ValidatorId = Nat

enum Phase { Tick, Deliver } derive eq, order

enum Verdict { Accept(Slot), Reject(Slot, String), Pending } derive eq

// Set を含むので order は derive できない(E005 になる)。eq だけ。
record Block {
  slot: Slot,
  parent: Option<Slot>,
  votes: Set<ValidatorId>,
} derive eq

state Store {
  head: Block,
  seen: List<Block>,
  weights: Table<ValidatorId, Nat>,
}

input proposer(slot: Slot) -> ValidatorId

fn phaseRank(p: Phase) -> Nat {
  match p {
    Phase.Tick => 0,
    Phase.Deliver => 1,
  }
}

fn verdictSlot(v: Verdict) -> Option<Slot> {
  match v {
    Verdict.Accept(s) => Some(s),
    Verdict.Reject(s, _) => Some(s),
    Verdict.Pending => None,
  }
}

fn extend(st: Store, b: Block) -> Store {
  let seen = [b];
  if b.slot > st.head.slot {
    Store { head: b, seen: seen, ..st }
  } else {
    Store { ..st }
  }
}

fn describe(o: Option<Slot>) -> Nat {
  match o {
    Some(s) if s > 0 => s,
    Some(_) => 0,
    None => 0,
  }
}

// List からの find? は先頭一致で決定的
fn firstAtSlotOne(xs: List<Block>) -> Option<Block> {
  xs.find?(|b| b.slot == 1)
}

// Set → List は sort(by = …) で順序を明示する(E004 にならない)
fn voters(b: Block) -> List<ValidatorId> {
  sort(b.votes, by = |v| v)
}

fn votersDesc(b: Block) -> List<ValidatorId> {
  b.votes.sort(by = |v| -v.toInt())
}

// Set からの選択は findUnique? / minBy? / maxBy? だけ(E003 にならない)
fn uniqueVoter(b: Block, who: ValidatorId) -> Option<ValidatorId> {
  b.votes.findUnique?(|v| v == who)
}

// List の maxBy? は鍵の order だけを要する(Block 自身に order は要らない)
fn heaviest(st: Store) -> Option<Block> {
  st.seen.maxBy?(|b| b.votes.size())
}

fn weightOf(st: Store, v: ValidatorId) -> Nat {
  st.weights.getOr(v, 0)
}

fn totalWeight(st: Store, b: Block) -> Nat {
  sort(b.votes, by = |v| v).fold(0, |acc, v| acc + weightOf(st, v))
}

fn pairSlots(p: (Slot, Slot)) -> Nat {
  match p {
    (a, b) => a + b,
  }
}

fn withVotes(b: Block, vs: List<ValidatorId>) -> Block {
  Block { votes: Set.of(vs), ..b }
}

fn parentOr(b: Block) -> Slot {
  b.parent.getOr(0)
}

predicate HeadIsLatest(st: Store) {
  forall b: Block { b.slot <= st.head.slot }
}

condition Synchronous(delta: Nat) { delta > 0 }

regime Honest(st: Store) { HeadIsLatest(st) && !(st.head.slot == 0) }

claim headMonotone(st: Store, b: Block) {
  Honest(st) implies HeadIsLatest(extend(st, b))
}

claim headPositive(st: Store) {
  Honest(st) implies st.head.slot > 0
}

claim bundle Liveness { headPositive }

claim bundle Smoke { headMonotone, positive: headPositive, nested: Liveness }

protocol Demo {
  fn step(st: Store) -> Store { st }
}

observer headSlot(st: Store) -> Nat { st.head.slot }

scenario basic {
  let b = Block { slot: 1, parent: None, votes: Set.empty() };
  let st = Store { head: b, seen: [], weights: Table.empty() };
  describe(Some(extend(st, b).head.slot))
}
