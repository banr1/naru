// verified-consensus の移植: DecoupledConsensusModel/Protocol/Evidence.lean の Prop 側(`SlashableBetween` /
// `HasIntersectionWeight` / `HasSlashableWeightBetween`)、DecoupledConsensusModel/Execution/Setup.lean の
// `RootInjectiveBelow` / `RootInjectiveOnAncestors`、DecoupledConsensusStatements/Instantiation/Certificates.lean の
// `NamedFinalizedAt`。Evidence.naru / Setup.naru の冒頭が「Statements の移植で書く」とした述語。
//
// - `∃ a ∈ A₁, …` → `exists a: CombinedAttestation { a1.contains(a) && … }`、`Protocol.Slashable a b`(Prop)→ Model の
//   `slashable(a, b)`(Bool)。
// - `∃ S : Finset V, …`(有限集合の存在)→ `exists members: List<ValidatorId>` + `members.toSet()`: naru の `Set` の正規形
//   (昇順・重複なし)は `toSet()` が作るので、List で量化して正規化した集合に `weightOf` を当てる(重複で重みを数え
//   過ぎない。SYNTAX.md「Statements backend」の既知の制限を避ける書き方)。
// - `RootInjectiveBelow {tip₁, tip₂}` の `∃ B ∈ {tip₁, tip₂}, A ⪯ B` → `preceq(a, tip1) || preceq(a, tip2)`。
module Consensus.Statements.Accountability

import Consensus.Objects.Identifiers
import Consensus.Objects.Blocks
import Consensus.Objects.NamedBlocks
import Consensus.Objects.Weights
import Consensus.Objects.Parameters
import Consensus.Protocol.ChainState

// A validator `i` is slashable between two evidence sets: one occurrence from each, both `i`'s, satisfying E1 or E2.
// `a` and `b` are chosen independently, so the conflicting occurrences can be in one attestation.
predicate SlashableBetween(a1: Set<CombinedAttestation>, a2: Set<CombinedAttestation>, i: ValidatorId) {
  exists a: CombinedAttestation { exists b: CombinedAttestation {
    a1.contains(a) && a2.contains(b) && a.valIndex == i && b.valIndex == i && slashable(a, b)
  } }
}

// The weight floor w(S) ≥ 2q − W for an intersection of two quorums, written additively as 2q ≤ W + w(S).
condition HasIntersectionWeight(e: ProtocolEnv, w: Set<ValidatorId>) {
  2 * envQ(e) <= envW(e) + weightOf(e.electorate, w)
}

// Slashable weight 2q − W between two evidence sets (the accountability conclusion form).
predicate HasSlashableWeightBetween(e: ProtocolEnv, a1: Set<CombinedAttestation>, a2: Set<CombinedAttestation>) {
  exists members: List<ValidatorId> {
    let w = members.toSet();
    HasIntersectionWeight(e, w) && forall i: ValidatorId { w.contains(i) implies SlashableBetween(a1, a2, i) }
  }
}

// Roots identify blocks within the ancestry below the two tips (手書き `RootInjectiveOnAncestors` =
// `RootInjectiveBelow {tip₁, tip₂}`): the collision-free hash idealization on two chains.
predicate RootInjectiveOnAncestors(tip1: Block, tip2: Block) {
  forall a: Block { forall c: Block {
    (preceq(a, tip1) || preceq(a, tip2)) && (preceq(c, tip1) || preceq(c, tip2)) && root(a) == root(c)
      implies a == c
  } }
}

// The internal certificate-finalization predicate: the named derived state of `c` carries (F, h_F) = (target, h).
predicate NamedFinalizedAt(e: ProtocolEnv, cfg: HeightConfig, c: NamedBlock, target: Block, h: Height) {
  deriveNamed(e, cfg, c).f == target && deriveNamed(e, cfg, c).hF == h
}
