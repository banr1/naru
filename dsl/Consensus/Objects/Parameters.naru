// verified-consensus の移植: DecoupledConsensusModel/Objects/Parameters.lean(§1 protocol environment)。
// 手書きの `Env`(`Δ` `Δ_pos` `t_GST` `t_GST_nonneg` `proposer` `committees` `electorate`)と
// `Env.committee` / `Env.t` / `Env.slotOf` / `Env.W` / `Env.q` に対応する。
//
// - `Δ_pos`(0 < Δ)と `t_GST_nonneg`(0 ≤ t_GST)は証明の欄なので Model には置かず、Statements の premise にする。
// - `proposer : Slot → V` と `committees.members : Slot → Finset V` は環境のオラクル(非決定性)なので
//   naru では `input` として明示する(IDEAL.md「言語の意味論」)。scenario が値を与える。
// - 名前は将来の stdlib(Model 用の `Env`: Δ / GST / electorate / awake)と分けるため `ProtocolEnv` にする。
module Consensus.Objects.Parameters

import Consensus.Objects.Identifiers
import Consensus.Objects.Time
import Consensus.Objects.Weights

// §1 the fixed protocol environment: the schedule unit Δ, t_GST, and the weighted electorate.
record ProtocolEnv { delta: Time, tGST: Time, electorate: Electorate } derive eq

// §1 the assigned proposer of each slot.
input proposer(slot: Slot) -> ValidatorId

// §1 the fixed committees K_s ⊆ V. Goldfish counts cardinalities of subsets of K_s, never weights.
input committee(slot: Slot) -> Set<ValidatorId>

// §1 t_s = 4Δs
fn slotTime(e: ProtocolEnv, s: Slot) -> Time { slotStart(e.delta, s) }

// §1 s = ⌊t / 4Δ⌋
fn slotOf(e: ProtocolEnv, u: Time) -> Slot { slotOfTime(e.delta, u) }

// §3 W = w(V)
fn envW(e: ProtocolEnv) -> Nat { totalWeight(e.electorate) }

// §4 q = ⌈2W/3⌉
fn envQ(e: ProtocolEnv) -> Nat { finalityThreshold(e.electorate) }
