  let «erased» : Model.Consensus.Objects.Blocks.CombinedAttestation := Model.Consensus.Objects.NamedBlocks.eraseAttestation «row»
  let «after» : Model.Consensus.Protocol.Store.Store := Model.Consensus.Protocol.Handlers.onSgVote «hc» «st».«core» «erased»
  if (!(NaruStd.Set.contains (Model.Consensus.Protocol.Store.sgPool «st».«core» «row».«round») «erased»)) && (NaruStd.Set.contains (Model.Consensus.Protocol.Store.sgPool «after» «row».«round») «erased») then
    ({ «st» with «core» := «after», «sgRows» := NaruStd.Table.insert «st».«sgRows» «row».«round» ((NaruStd.Table.getOr «st».«sgRows» «row».«round» ([] : (List Model.Consensus.Objects.NamedBlocks.NamedAttestation))) ++ [«row»]) } : Model.Consensus.Protocol.Handlers.NamedStore)
  else
    ({ «st» with «core» := «after» } : Model.Consensus.Protocol.Handlers.NamedStore)

-- naru fn
def Model.Consensus.Protocol.Handlers.admitRows («hc» : Model.Consensus.Protocol.Grades.HealConfig) («st» : Model.Consensus.Protocol.Handlers.NamedStore) («rows» : (List Model.Consensus.Objects.NamedBlocks.NamedAttestation)) : Model.Consensus.Protocol.Handlers.NamedStore :=
  List.foldl (fun («acc» : Model.Consensus.Protocol.Handlers.NamedStore) («row» : Model.Consensus.Objects.NamedBlocks.NamedAttestation) =>
     Model.Consensus.Protocol.Handlers.admitRow «hc» «acc» «row») «st» «rows»

-- naru fn
def Model.Consensus.Protocol.Handlers.admitCarried («_admission» : Model.Consensus.Protocol.Handlers.CarriedAdmission) («hc» : Model.Consensus.Protocol.Grades.HealConfig) («before» : Model.Consensus.Protocol.Handlers.NamedStore) («after» : Model.Consensus.Protocol.Handlers.NamedStore) («b» : Model.Consensus.Objects.NamedBlocks.NamedBlock) : Model.Consensus.Protocol.Handlers.NamedStore :=
  if (!(NaruStd.Set.contains «before».«bodies» «b»)) && (NaruStd.Set.contains «after».«bodies» «b») then
    Model.Consensus.Protocol.Handlers.admitRows «hc» «after» (Model.Consensus.Objects.NamedBlocks.namedAttestations «b»)
  else
    «after»

