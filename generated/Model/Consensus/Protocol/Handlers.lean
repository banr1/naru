def Model.Consensus.Protocol.Handlers.onBlockWith (committee' : (Nat → (NaruStd.Set Model.Consensus.Objects.Identifiers.ValidatorId))) (proposer' : (Nat → Model.Consensus.Objects.Identifiers.ValidatorId)) («admission» : Model.Consensus.Protocol.Handlers.CarriedAdmission) («e» : Model.Consensus.Objects.Parameters.ProtocolEnv) («hc» : Model.Consensus.Protocol.Grades.HealConfig) («cfg» : Model.Consensus.Protocol.ChainState.HeightConfig) («st» : Model.Consensus.Protocol.Handlers.NamedStore) («b» : Model.Consensus.Objects.NamedBlocks.NamedBlock) : Model.Consensus.Protocol.Handlers.NamedStore :=
  Model.Consensus.Protocol.Handlers.admitCarried «admission» «hc» «st» (Model.Consensus.Protocol.Handlers.processBlockCore committee' proposer' «e» «hc» «cfg» «st» «b») «b»
